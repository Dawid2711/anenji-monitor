// ====== Ochrona przed wadliwą aktualizacją (automatyczny powrót do poprzedniej wersji) ======
// Po aktualizacji nowa wersja startuje "na próbę". Jeśli zawiesi się/zrestartuje, zanim
// się zatwierdzi (otaConfirm), bootloader wraca do poprzedniej, działającej wersji.
extern "C" bool verifyRollbackLater() { return true; }   // zatwierdzamy sami, później
bool otaConfirmed = false;

void otaConfirm() {
  if (otaConfirmed) return;
  unsigned long up = millis();
  // zatwierdź po 60 s pracy z WiFi, albo po 10 min nawet bez WiFi (np. awaria routera)
  if (!((up > 60000UL && WiFi.status() == WL_CONNECTED) || up > 600000UL)) return;
  otaConfirmed = true;
  const esp_partition_t* run = esp_ota_get_running_partition();
  esp_ota_img_states_t st;
  if (esp_ota_get_state_partition(run, &st) == ESP_OK && st == ESP_OTA_IMG_PENDING_VERIFY) {
    esp_ota_mark_app_valid_cancel_rollback();
    Serial.println("[OTA] Nowa wersja zatwierdzona");
  }
}

