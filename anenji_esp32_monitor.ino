// ====== MiniModbus (25.11.2026) - prosty klient Modbus RTU, zgodny z API ModbusMaster ======
// Funkcje 0x03 (holding) i 0x04 (input). Krótki timeout, żeby brak falownika nie blokował WWW.
class MiniModbus {
public:
  static const uint8_t ku8MBSuccess          = 0x00;
  static const uint8_t ku8MBIllegalFunction  = 0x01;
  static const uint8_t ku8MBInvalidSlaveID   = 0xE0;
  static const uint8_t ku8MBInvalidFunction  = 0xE1;
  static const uint8_t ku8MBResponseTimedOut = 0xE2;
  static const uint8_t ku8MBInvalidCRC       = 0xE3;
  static const uint8_t MAX_REGS = 64;

  void begin(uint8_t id, Stream& s) { _id = id; _s = &s; }
  void preTransmission(void (*f)())  { _pre = f; }
  void postTransmission(void (*f)()) { _post = f; }
  void setBaud(uint32_t b) { _baud = b ? b : 9600; }
  uint8_t readHoldingRegisters(uint16_t a, uint16_t n) { return req(0x03, a, n); }
  uint8_t readInputRegisters(uint16_t a, uint16_t n)   { return req(0x04, a, n); }
  uint16_t getResponseBuffer(uint8_t i) { return i < MAX_REGS ? _buf[i] : 0; }

private:
  Stream* _s = nullptr;
  uint8_t _id = 1;
  uint32_t _baud = 9600;
  void (*_pre)() = nullptr;
  void (*_post)() = nullptr;
  uint16_t _buf[MAX_REGS] = { 0 };

  static uint16_t crc16(const uint8_t* d, size_t n) {
    uint16_t c = 0xFFFF;
    for (size_t i = 0; i < n; i++) {
      c ^= d[i];
      for (int b = 0; b < 8; b++) c = (c & 1) ? (c >> 1) ^ 0xA001 : c >> 1;
    }
    return c;
  }

  uint8_t req(uint8_t fn, uint16_t addr, uint16_t n) {
    if (!_s || n == 0 || n > MAX_REGS) return ku8MBIllegalFunction;
    while (_s->available()) _s->read();               // wyrzuć śmieci z poprzednich ramek
    uint8_t q[8] = { _id, fn, (uint8_t)(addr >> 8), (uint8_t)addr, (uint8_t)(n >> 8), (uint8_t)n, 0, 0 };
    uint16_t c = crc16(q, 6); q[6] = c & 0xFF; q[7] = c >> 8;
    if (_pre) _pre();
    _s->write(q, 8);
    _s->flush();                                       // czekaj, aż ramka fizycznie wyjdzie
    if (_post) _post();

    const size_t want = 5 + 2 * n;                     // id fn len dane... crc crc
    uint8_t r[5 + 2 * MAX_REGS];
    size_t got = 0;
    uint32_t byteUs = 11000000UL / _baud;              // 11 bitów na znak
    uint32_t gapMs  = byteUs * 4 / 1000 + 3;           // cisza po ramce = koniec odpowiedzi
    uint32_t tmoMs  = 300 + (want * byteUs) / 1000;    // całkowity limit czekania
    uint32_t t0 = millis(), tLast = 0;
    while (millis() - t0 < tmoMs) {
      if (_s->available()) {
        uint8_t b = _s->read();
        if (got < sizeof(r)) r[got++] = b;
        tLast = millis();
        if (got >= 5 && (r[1] & 0x80)) break;          // ramka wyjątku (5 B)
        if (got >= want) break;
      } else {
        if (got && millis() - tLast > gapMs) break;    // falownik skończył nadawać
        delay(1);
      }
    }
    if (got == 0) return ku8MBResponseTimedOut;
    if (r[0] != _id) return ku8MBInvalidSlaveID;
    if (r[1] & 0x80) {
      if (got < 5 || crc16(r, 3) != (uint16_t)(r[3] | (r[4] << 8))) return ku8MBInvalidCRC;
      return r[2];                                     // kod wyjątku Modbus (1..11)
    }
    if (r[1] != fn) return ku8MBInvalidFunction;
    if (got < want) return ku8MBResponseTimedOut;      // niepełna ramka
    if (r[2] != 2 * n) return ku8MBInvalidCRC;
    if (crc16(r, want - 2) != (uint16_t)(r[want - 2] | (r[want - 1] << 8))) return ku8MBInvalidCRC;
    for (uint16_t i = 0; i < n; i++) _buf[i] = (r[3 + 2 * i] << 8) | r[4 + 2 * i];
    return ku8MBSuccess;
  }
};
