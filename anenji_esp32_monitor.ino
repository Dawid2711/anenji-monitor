// ====== Modbus ======
// 25.11.2026: rejestry holding czytane jednym blokiem; pojedynczo tylko input i przy blockBad.
static bool sigSet(int i, uint16_t raw) {
  Sig &s = sigs[i];
  float v = s.sgn ? (float)(int16_t)raw : (float)raw;
  *s.val = v * s.scale;
  s.st = 1;
  return i == S_BC;
}

bool readAll() {
  bool any = false;
  int fails = 0;
  bool bcRead = false;
  bool done[NUM_SIGS] = { false };

  // --- 1) odczyt blokowy rejestrów holding ---
  if (!blockBad) {
    int lo = 0x7FFFFFFF, hi = -1;
    for (int i = 0; i < NUM_SIGS; i++) {
      if (sigs[i].addr < 0 || sigs[i].type) continue;
      int a = sigs[i].addr + addrOff; if (a < 0) a = 0;
      if (a < lo) lo = a;
      if (a > hi) hi = a;
    }
    if (hi >= 0 && hi - lo + 1 <= MiniModbus::MAX_REGS) {
      uint8_t r = node.readHoldingRegisters((uint16_t)lo, (uint16_t)(hi - lo + 1));
      if (r == node.ku8MBSuccess) {
        for (int i = 0; i < NUM_SIGS; i++) {
          if (sigs[i].addr < 0 || sigs[i].type) continue;
          int a = sigs[i].addr + addrOff; if (a < 0) a = 0;
          if (sigSet(i, node.getResponseBuffer(a - lo))) bcRead = true;
          done[i] = true; any = true;
        }
      } else if (r == node.ku8MBResponseTimedOut) {
        // falownik milczy: nie męczymy go kolejnymi zapytaniami w tym cyklu
        for (int i = 0; i < NUM_SIGS; i++) sigs[i].st = sigs[i].addr < 0 ? 3 : (sigs[i].type ? 2 : 0);
        return false;
      } else {
        blockBad = true;   // odpowiedział, ale bloku nie chce (wyjątek/CRC) - dalej pojedynczo
        Serial.printf("[MB] Odczyt blokowy %d..%d odrzucony (kod %u) - przechodzę na pojedynczy\n", lo, hi, r);
      }
      netPoll();
    }
  }

  // --- 2) pozostałe rejestry pojedynczo ---
  for (int i = 0; i < NUM_SIGS; i++) {
    Sig &s = sigs[i];
    if (s.addr < 0) { s.st = 3; continue; }
    if (done[i]) continue;
    int a = s.addr + addrOff;
    if (a < 0) a = 0;
    uint8_t r = s.type ? node.readInputRegisters((uint16_t)a, 1)
                       : node.readHoldingRegisters((uint16_t)a, 1);
    if (r == node.ku8MBSuccess) {
      if (sigSet(i, node.getResponseBuffer(0))) bcRead = true;
      any = true; fails = 0;
    } else {
      s.st = 0;
      if (++fails >= 3) {
        for (int j = i + 1; j < NUM_SIGS; j++) if (sigs[j].addr >= 0 && !done[j]) sigs[j].st = 2;
        break;
      }
    }
    netPoll();
    yield();
  }
  if (any) {
    if (bcRead) bat_current += bcOffset;
    bat_power = bat_voltage * bat_current * batSign;
    if (sigs[S_GRID].addr >= 0 && sigs[S_GRID].st == 1) {
      grid_power = grid_raw > 0 ? grid_raw : 0;
    } else if ((int)op_mode == 3) {
      grid_power = 0;
    } else {
      float g = load_power + bat_power - pv_power;
      grid_power = g > 0 ? g : 0;
    }
  }
  return any;
}

// ====== WiFi start ======
void startAp() {
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(AP_SSID, AP_PASS);
  apActive = true;
  Serial.print("AP: "); Serial.print(AP_SSID); Serial.print("  IP: "); Serial.println(WiFi.softAPIP());
  String ws_ = prefs.getString("wssid", "");
  if (ws_.length()) WiFi.begin(ws_.c_str(), prefs.getString("wpass", "").c_str());
}

void wifiStart() {
  String ws_ = prefs.getString("wssid", "");
  String wp  = prefs.getString("wpass", "");
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  if (ws_.length()) {
    WiFi.begin(ws_.c_str(), wp.c_str());
    Serial.print("Laczenie z WiFi: "); Serial.println(ws_);
    unsigned long t = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t < 20000) { delay(300); Serial.print("."); }
    Serial.println();
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("IP: "); Serial.println(WiFi.localIP());
  } else {
    startAp();
  }
}

// AP startuje po 5 min bez WiFi i wyłącza się po 1 min stabilnego połączenia z routerem
void wifiWatch() {
  static unsigned long discSince = 0, connSince = 0;
  if (WiFi.status() == WL_CONNECTED) {
    discSince = 0;
    if (apActive) {
      if (!connSince) connSince = millis();
      if (millis() - connSince > 60000UL) {
        WiFi.softAPdisconnect(true);
        apActive = false;
        connSince = 0;
        Serial.println("WiFi OK - AP wylaczony");
      }
    }
    return;
  }
  connSince = 0;
  if (apActive) return;
  if (!discSince) discSince = millis();
  if (millis() - discSince > 300000UL) startAp();
}

void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("\nStart... wersja " + String(FW_VER));

  prefs.begin("anenji", false);
  loadCfg();

  if (LittleFS.begin(true)) { loadState(); loadHist(); } else Serial.println("LittleFS niedostepny");

  pinMode(MAX485_DE, OUTPUT);
  digitalWrite(MAX485_DE, LOW);
  applyModbus();

  wifiStart();
  configTzTime("CET-1CEST,M3.5.0,M10.5.0/3", "pool.ntp.org", "time.google.com");
  if (MDNS.begin("anenji")) MDNS.addService("http", "tcp", 80);

  server.on("/", HTTP_GET, handleRoot);
  server.on("/data", HTTP_GET, handleData);
  server.on("/history", HTTP_GET, handleHistory);
  server.on("/days", HTTP_GET, handleDays);
  server.on("/days.csv", HTTP_GET, handleDaysCsv);
  server.on("/dayclear", HTTP_POST, handleDayClear);
  server.on("/cfg", HTTP_GET, handleCfg);
  server.on("/save", HTTP_POST, handleSave);
  server.on("/reset", HTTP_POST, handleReset);
  server.on("/test", HTTP_GET, handleTest);
  server.on("/restart", HTTP_POST, handleRestart);
  server.on("/ota", HTTP_POST, handleOtaDone, handleOtaUpload);
  server.on("/otapw", HTTP_POST, handleOtaPw);
  server.on("/wifi", HTTP_GET, handleWifi);
  server.on("/wscan", HTTP_GET, handleWscan);
  server.on("/wsave", HTTP_POST, handleWsave);
  server.on("/scanid", HTTP_GET, handleScanId);
  server.on("/scanregs", HTTP_GET, handleScanRegs);
  server.on("/ghstatus", HTTP_GET, handleGhStatus);
  server.on("/ghsave", HTTP_POST, handleGhSave);
  server.on("/ghcheck", HTTP_GET, handleGhCheck);
  server.on("/ghupdate", HTTP_POST, handleGhUpdate);
  server.begin();

  ws.begin();
  ws.onEvent(wsEvent);
  ws.enableHeartbeat(15000, 3000, 2);   // usuwa "martwe" połączenia (zamknięta karta, uśpiony telefon)
  Serial.println("Serwer HTTP (80) i WebSocket (81) uruchomione.");
}

void loop() {
  server.handleClient();
  ws.loop();
  otaConfirm();
  checkDay();
  wifiWatch();

  if (restartAt && (long)(millis() - restartAt) >= 0) {
    saveState(); saveHist();
    delay(100);
    ESP.restart();
  }

  if (ghCheckReq) { ghCheckReq = false; ghCheckStart(); }
  if (ghUpdateReq) { ghUpdateReq = false; ghUpdateStart(); }

  // Sprawdzanie wersji na GitHubie: raz po starcie (~90 s) i codziennie od 12:00
  if (ghEnable && !ghUpdating && WiFi.status() == WL_CONNECTED) {
    static bool bootChecked = false;
    static int lastKey = -1;
    time_t tn = time(nullptr);
    if (tn > 1700000000) {
      struct tm tmx; localtime_r(&tn, &tmx);
      int key = tmx.tm_year * 400 + tmx.tm_yday;
      if (!bootChecked && millis() > 90000UL) {
        bootChecked = true;
        if (tmx.tm_hour >= 12) lastKey = key;
        ghCheckStart();
      } else if (tmx.tm_hour == 12 && key != lastKey) {
        lastKey = key;
        ghCheckStart();
      }
    }
  }

  if (scanRun) { scanStep(); return; }

  unsigned long now = millis();
  unsigned long interval = modbusOk ? LIVE_MS : OFFLINE_MS;

  if (now - lastRead >= interval) {
    unsigned long dt = now - lastRead;
    if (dt > 5000) dt = 5000;
    lastRead = now;
    modbusOk = readAll();
    if (modbusOk) {
      double h = dt / 3600000.0;
      pv_wh   += pv_power * h;
      load_wh += load_power * h;
      grid_wh += grid_power * h;
      if (bat_power > 0) pv_bat_wh += bat_power * h;
      accPv += pv_power; accLd += load_power; accGr += grid_power; accN++;
      accS_pv += pv_power; accS_ld += load_power; accS_gr += grid_power; accS_n++;
    }
    wsPush();   // nowe dane od razu do wszystkich otwartych stron

    static unsigned long lastLog = 0;
    if (now - lastLog >= 10000UL) {
      lastLog = now;
      Serial.printf("Mode=%d PV=%.0fW SOC=%.0f%% Load=%.0fW Bat=%.1fV %.1fA Grid=%.0fW AC=%.1fV Modbus=%s WS=%d\n",
                    (int)op_mode, pv_power, bat_soc, load_power, bat_voltage, bat_current,
                    grid_power, ac_voltage, modbusOk ? "OK" : "BRAK", ws.connectedClients());
    }
  }

  // próbka co 30 s (wykresy 15 min i 1 h)
  if (now - lastShort >= 30000UL) {
    lastShort = now;
    pushHistShort(accS_n ? (uint16_t)(accS_pv / accS_n) : 0,
                  accS_n ? (uint16_t)(accS_ld / accS_n) : 0,
                  accS_n ? (uint16_t)(accS_gr / accS_n) : 0);
    accS_pv = accS_ld = accS_gr = 0; accS_n = 0;
  }

  // próbka co 5 min (wykresy 6 h i 24 h)
  if (now - lastHist >= 300000UL) {
    lastHist = now;
    // 25.11.2026: bez odczytów zapisujemy 0, a nie ostatnią (nieaktualną) wartość
    pushHist(accN ? (uint16_t)(accPv / accN) : 0,
             accN ? (uint16_t)(accLd / accN) : 0,
             accN ? (uint16_t)(accGr / accN) : 0);
    acc_h_pv += accPv; acc_h_ld += accLd; acc_h_gr += accGr; acc_h_n += accN;
    accPv = accLd = accGr = 0; accN = 0;
  }

  // próbka co godzinę (wykresy 7 i 30 dni)
  static unsigned long lastHour = 0;
  if (now - lastHour >= 3600000UL) {
    lastHour = now;
    if (acc_h_n > 0) {
      pushHistHourly((uint16_t)(acc_h_pv / acc_h_n),
                     (uint16_t)(acc_h_ld / acc_h_n),
                     (uint16_t)(acc_h_gr / acc_h_n));
    } else {
      pushHistHourly(0, 0, 0);   // 25.11.2026: brak odczytów w tej godzinie
    }
    acc_h_pv = acc_h_ld = acc_h_gr = 0; acc_h_n = 0;
  }

  if (now - lastSave >= 600000UL) { lastSave = now; saveState(); }
  if (now - lastHistSave >= 1800000UL) { lastHistSave = now; saveHist(); }
}
